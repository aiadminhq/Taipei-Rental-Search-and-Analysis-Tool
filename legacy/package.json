{
  "name": "trsat-legacy",
  "version": "1.0.0",
  "description": "591租屋網站到Notion智能自動化系統 - MCP整合版本",
  "main": "../src/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node ../src/index.js",
    "dev": "nodemon ../src/index.js",
    "web": "node ../src/webServer.js",
    "web:dev": "nodemon ../src/webServer.js",
    "crm": "concurrently \"npm:mcp\" \"npm:web\"",
    "crm:dev": "concurrently \"npm:mcp\" \"npm:web:dev\"",
    "enhanced": "node ../src/enhancedApp.js",
    "enhanced:dev": "nodemon ../src/enhancedApp.js",
    "mcp": "node ../src/mcp/mcpServer.js",
    "monitor": "node ../src/monitorApp.js",
    "monitor:dev": "nodemon ../src/monitorApp.js",
    "test": "jest",
    "lint": "echo 'Linting not configured yet'"
  },
  "keywords": [
    "591",
    "notion",
    "rental",
    "automation",
    "mcp",
    "ai",
    "scraping",
    "real-estate"
  ],
  "author": "Augment Agent",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.1",
    "axios": "^1.10.0",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.12.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10"
  }
}
