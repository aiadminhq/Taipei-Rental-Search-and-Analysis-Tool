# 依賴套件
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 環境變數
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 保留範例檔案
!.env.example
!claude_desktop_config_converted.example.json

# 忽略含有機敏資料的設定檔
claude_desktop_config.json
claude_desktop_config_converted.json

# 日誌檔案
logs/
*.log

# Runtime 資料
pids
*.pid
*.seed
*.pid.lock

# 覆蓋率報告
coverage/
.nyc_output

# Playwright
playwright-report/
test-results/

# 編譯結果
dist/
build/

# IDE 設定 (保留專案配置)
.idea/
*.swp
*.swo
*~
# 保留 VSCode 專案設定
!.vscode/

# OS 檔案
.DS_Store
Thumbs.db

# 暫存檔案
tmp/
temp/
.tmp.drivedownload/
.tmp.driveupload/

# PM2 檔案
ecosystem.config.js

# 測試檔案（暫時忽略）
test-*.js
scraper-test.js

# 備份檔案
*.bak
*.backup

# 系統生成的檔案
*.tgz
*.tar.gz

# TRSAT CLI sessions / browser profiles (never commit)
.trsat/
storageState*.json
*.cookies.json
profiles/
# TRSAT crawl output (contains PII)
data/listings.json
data/raw/