# 591 Notion 自動化系統 - 環境變數配置範例
# 複製此檔案為 .env 並填入實際數值

# ===========================================
# 核心服務配置 | Core Service Configuration
# ===========================================

# Notion API 配置
NOTION_API_KEY=ntn_your_notion_key
NOTION_DATABASE_ID=your_notion_database_id

# Firecrawl API 配置
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# ===========================================
# MCP 服務器配置 | MCP Server Configuration
# ===========================================

# MCP 服務器端口
MCP_PORT=3001

# Web 服務器端口
WEB_PORT=3000

# 監控服務器端口
MONITOR_PORT=3002

# 伺服器設定 (向下相容)
PORT=0591
NODE_ENV=development

# 591 爬蟲設定
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
REQUEST_DELAY=2000
MAX_RETRIES=3

# 評分系統設定
SCORING_ENABLED=true
AUTO_SCORE=true
MIN_SCORE_THRESHOLD=60

# 安全設定
SESSION_SECRET=your_session_secret_here
CORS_ORIGIN=http://localhost:3000

# 日誌設定
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 效能設定
MAX_CONCURRENT_REQUESTS=5
CACHE_TTL=300

# 開發模式設定
DEBUG=false
HOT_RELOAD=true

# ===========================================
# 21st.dev Magic 配置 | Magic Configuration
# ===========================================

# Magic API 金鑰
MAGIC_API_KEY=your-magic-api-key

# 專案類型
PROJECT_TYPE=rental-analysis-platform

# 設計系統
DESIGN_SYSTEM=modern-tech

# 主要顏色
PRIMARY_COLOR=#0400ff

# 強調顏色
ACCENT_COLOR=#00ffcc

# 互動顏色
INTERACTIVE_COLOR=#ff00c8

# ===========================================
# Firecrawl 進階配置 | Advanced Configuration
# ===========================================

# 抓取間隔 (毫秒)
SCRAPE_INTERVAL=5000

# 批量處理大小
BATCH_SIZE=10

# 請求超時 (毫秒)
REQUEST_TIMEOUT=30000

# 啟用快取
ENABLE_CACHE=true

# 快取過期時間 (秒)
CACHE_EXPIRY=3600

# ===========================================
# 使用說明 | Usage Instructions
# ===========================================

# 1. 複製此檔案為 .env
# 2. 填入您的實際 API 金鑰和配置值
# 3. 確保 .env 檔案不會被提交到版本控制系統
# 4. 重新啟動應用程式以載入新的環境變數

# 注意事項：
# - 請勿在生產環境中使用預設值
# - 定期更新 API 金鑰以確保安全性
# - 監控 API 使用量以避免超出限制